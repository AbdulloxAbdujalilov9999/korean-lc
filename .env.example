# Copy to .env.local for local dev (Vercel: set these in Project Settings -> Environment Variables instead).
# Nothing here is required to use the app itself — every feature degrades gracefully without it (see README).

# ---- ElevenLabs: Korean + Uzbek voiceover (teach slideshow, TTS). Never English. ----
ELEVENLABS_API_KEY=
# Defaults already set in api/tts.js to voices that work; override only if you want a different voice.
# ELEVENLABS_VOICE_KO=
# ELEVENLABS_VOICE_KO_MALE=
# ELEVENLABS_UZ_VOICE=
# ELEVENLABS_MODEL_KO=eleven_multilingual_v2
# ELEVENLABS_MODEL_UZ=eleven_v4

# ---- ElevenLabs Conversational AI: the live voice-call teacher ----
# Create the agent in the ElevenLabs dashboard (Conversational AI -> Agents -> Import) using
# elevenlabs/teacher.agent.json as the starting config, then paste its id here.
ELEVENLABS_AGENT_ID=

# ---- Anthropic: the text tutor/translator/lesson-teacher chat (api/tutor.js) ----
ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-haiku-5-5

# ---- Not needed yet: no Firebase project exists for this app (api/_auth.js is a stub that lets everyone
# through). Wire this up when real accounts/sync are needed — see the comment at the top of api/_auth.js.
